# ═══════════════════════════════════════════════════════════
# Hermes Stack 環境變數
# 複製為 .env 並填入你的 API keys
# ═══════════════════════════════════════════════════════════

# ── LLM API Keys ─────────────────────────────────────────
# 至少需要一個，建議申請多個以分散風險

# Anthropic（Claude）— 教育、投資 Agent 主要用
# 申請：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# OpenAI — 電商 Agent 主要用
# 申請：https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Google AI（Gemini）— 個人 Agent 主要用
# 申請：https://aistudio.google.com/
GEMINI_API_KEY=xxxxxxxxxxxx

# DeepSeek — 備用（便宜）
# 申請：https://platform.deepseek.com/
DEEPSEEK_API_KEY=xxxxxxxxxxxx

# LongCat（龍貓）— 美团大模型，OpenAI 兼容格式
# 申請：https://longcat.chat/platform/api_keys
# API 端點：https://api.longcat.chat/openai
LONGCAT_API_KEY=ak_2Nc8gr87l6nV7Qs7588gE8kO3jR3U

# ── Redis 設定 ─────────────────────────────────────────
# LiteLLM 快取用，必須設定
REDIS_URL=redis://aios-redis:6379/1

# ── LiteLLM 管理密鑰 ────────────────────────────────────
# 自訂一個隨機字串，用於保護 LiteLLM 管理 API
LITELLM_MASTER_KEY=sk-hermes-master
LITELLM_SALT_KEY=change-this-to-random-string

# ── 網路代理（OpenClash）────────────────────────────────
# 如果 API 呼叫要經過 OpenClash 代理，取消下行註解
# HTTP_PROXY=http://192.168.9.9:7897
# HTTPS_PROXY=http://192.168.9.9:7897
# NO_PROXY=localhost,127.0.0.1,192.168.9.0/24,aios-redis,aios-qdrant,aios-postgres

# ── 時區 ────────────────────────────────────────────────
TZ=Asia/Shanghai
