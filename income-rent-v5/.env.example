# 收租佬 V6 環境變數配置
# 複製為 .env 並修改

# JWT 密鑰（生產環境請修改！）
JWT_SECRET=your-super-secret-key-change-this

# CORS 允許的來源
ALLOWED_ORIGINS=http://192.168.9.2:8080,http://localhost:8080,https://income.ccwu.cc

# 管理員賬號
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cloudflare Tunnel Token（可選，用於公網訪問）
# 從 Cloudflare Zero Trust > Access > Tunnels 獲取
CLOUDFLARE_TUNNEL_TOKEN=
